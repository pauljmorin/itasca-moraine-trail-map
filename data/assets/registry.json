 "format": "ITM-<type>-<nnn>",
 "notes": "Single source of truth for asset serial numbers (docs/asset-serial-numbers-2026-11-11.md). A serial is assigned at classification, never at photo intake \u2014 scripts/photo_pipeline.py build always writes serial null. Assignment is editorial: scripts/assign_serials.py stamps the next numbers in chainage order (west to east) per type, after the chapter has classified the pins through its interface and Paul has approved. Muse no longer classifies or grades (Nov 12, 2026) \u2014 new pins arrive as type UN with no condition. Never reuse, never renumber: a retired serial stays in retired with its reason. UN is a type value, never a serial prefix \u2014 no serial is ever issued for unclassified pins. Photographers: the pin carries the photographer code (initials); the full name lives only here, never on a public surface. At intake the pipeline stamps the photographer from --photographer (default PJM); a photo in a per-person subfolder (e.g. PJM/) takes that subfolder's code instead. A new code is added here with no full name until a human fills it in \u2014 a name is never invented. About three people photograph actively, up to ~12 total.",
 "prefix": "ITM",
 "types": {
  "BN": {
   "name": "bench",
   "note": "Paul's example; not yet observed in any classified photo.",
   "status": "proposed"
  },
  "BO": {
   "name": "bollard",
   "note": "Vehicle barrier \u2014 a short vertical log/timber post at a trail entrance; blocks vehicles, lets hikers through.",
   "status": "proposed"
  },
  "BR": {
   "name": "bridge",
   "status": "proposed"
  },
  "PN": {
   "name": "puncheon",
   "status": "proposed"
  },
  "CP": {
   "name": "carsonite post",
   "note": "The trail's standard marker post. A physical mile post is a CP, not a sign \u2014 the NCTA mile-marker layer is separate data.",
   "status": "seeded"
  },
  "CS": {
   "name": "campsite",
   "note": "Campsite / bivouac site.",
   "status": "seeded"
  },
  "KI": {
   "name": "kiosk",
   "status": "seeded"
  },
  "PK": {
   "name": "parking area",
   "note": "One serial per area, even if it has several signs; the signs themselves are SG items.",
   "status": "seeded"
  },
  "PO": {
   "name": "post",
   "note": "Post, other (non-Carsonite).",
   "status": "seeded"
  },
  "SG": {
   "name": "sign",
   "note": "One code for signs of any kind; subtype (regulatory, wayfinding, interpretive) goes in the pin's sign_kind field.",
   "status": "seeded"
  },
  "SH": {
   "name": "shelter",
   "status": "proposed"
  },
  "UN": {
   "name": "unclassified",
   "note": "A type value, never a serial prefix. Unclassified pins carry no serial.",
   "status": "bucket"
  },
  "WT": {
   "name": "water source",
   "note": "Water source (pump / spring / faucet).",
   "status": "proposed"
  },
  "LT": {
   "name": "latrine",
   "note": "Latrine (fibreglass latrine box at a campsite). Code approved by Paul Nov 11, 2026 with the first batch; ITM-LT-001 is the Lake Erin campsite latrine.",
   "status": "seeded"
  },
  "RG": {
   "name": "register",
   "note": "Trail register box. Code approved by Paul Nov 11, 2026 with the second batch; ITM-RG-001 is the Lake Erin trailhead register box.",
   "status": "seeded"
  },
  "BL": {
   "name": "blaze",
   "note": "Painted trail blaze on a tree trunk (no post or sign). Code approved by Paul Nov 20, 2026.",
   "status": "seeded"
  }
 },
 "photographers": {
  "PJM": {
   "name": "Paul Jeffrey Morin",
   "note": "Chapter volunteer. Public map shows initials only, never the full name."
  }
 }
}